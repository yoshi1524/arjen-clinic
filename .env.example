# ==============================================================================
# AR-JEN Maternity Clinic - Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials:
#   copy .env.example .env.local
#
# Do NOT commit .env.local to version control (contains private secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend & Database (Required)
# ------------------------------------------------------------------------------
# Find these in your Supabase Dashboard:
# -> Settings (gear icon) -> API -> Project URL & Project API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. Site / Application URL (Optional - defaults to http://localhost:3000)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Email Delivery Engine - NodeMailer via Gmail SMTP (Required for email alerts)
# ------------------------------------------------------------------------------
# Generate an App Password in your Google Account:
# -> Google Account Security -> 2-Step Verification -> App Passwords
EMAIL_USER=your-clinic-email@gmail.com
EMAIL_APP_PASSWORD=your-16-char-gmail-app-password
ADMIN_NOTIFICATION_EMAIL=admin@arjenclinic.com

# ------------------------------------------------------------------------------
# 4. Scheduled Background Jobs Security (Required for Vercel Cron routes)
# ------------------------------------------------------------------------------
# A secure random secret string passed in Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-random-cron-secret-token

